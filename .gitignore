# ---------- secrets & keys (never commit) ----------
.env
.env.*
*.pem
id_ed25519*

# ---------- military / case data (stays on this PC, never in git) ----------
/files/
/backend/uploads/*
!/backend/uploads/.gitkeep
!/backend/uploads/cases/
/backend/uploads/cases/*
!/backend/uploads/cases/.gitkeep
*.pdf
*.docx

# ---------- offline distribution artifacts (multi-GB, regenerated by scripts/) ----------
/offline/
/transfer/
*.zip
*.tar
*.tar.gz

# ---------- dependencies & build output ----------
node_modules/
dist/
.venv/
venv/
__pycache__/
*.pyc
/backend/wheels/
/backend/wheels-linux/

# ---------- logs & OS junk ----------
*.log
.DS_Store
Thumbs.db
desktop.ini
