server {
    listen 80;
    server_name _;

    root  /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml application/wasm;
    gzip_min_length 1024;

    # --------------------------------------------------------
    # Static assets -- long cache for hashed bundle files
    # --------------------------------------------------------
    location /assets/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # --------------------------------------------------------
    # API -- proxied to the FastAPI backend
    # --------------------------------------------------------
    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Long-running LLM / OCR calls
        proxy_read_timeout  600s;
        proxy_send_timeout  600s;
        proxy_buffering off;

        # Large PDF uploads (up to 12 exhibits)
        client_max_body_size 200m;
    }

    # --------------------------------------------------------
    # SPA fallback -- React Router style deep links
    # --------------------------------------------------------
    location / {
        try_files $uri $uri/ /index.html;
    }
}
